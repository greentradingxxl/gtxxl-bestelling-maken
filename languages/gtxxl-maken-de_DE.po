msgid "Een van de toegevoegde producten kan niet besteld worden."
msgstr "Eines der hinzugefügten Produkte kann nicht bestellt werden."

msgid "Van \"%1$s\" zijn er maar %2$d op voorraad."
msgstr "Von „%1$s“ sind nur %2$d auf Lager."

msgid "Voor dit land of gewicht staat er geen verzendtarief in de tabel."
msgstr "Für dieses Land oder Gewicht steht kein Versandtarif in der Tabelle."

msgid "Je mag geen bestellingen maken."
msgstr "Du darfst keine Bestellungen anlegen."

msgid "Kies minstens één product."
msgstr "Wähle mindestens ein Produkt."

msgid "Voor dit land of gewicht staat er geen verzendtarief in de tabel. Kies \"Geen verzendkosten\" en zet ze er daarna zelf bij."
msgstr "Für dieses Land oder Gewicht steht kein Versandtarif in der Tabelle. Wähle „Keine Versandkosten“ und trage sie danach selbst ein."

msgid "Voornaam"
msgstr "Vorname"

msgid "Achternaam"
msgstr "Nachname"

msgid "E-mailadres"
msgstr "E-Mail-Adresse"

msgid "Straat en huisnummer"
msgstr "Straße und Hausnummer"

